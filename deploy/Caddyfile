wojiecihuo.cn, www.wojiecihuo.cn {
    root * /srv
    encode zstd gzip

    @www host www.wojiecihuo.cn
    redir @www https://wojiecihuo.cn{uri} permanent

    @assets path /_astro/*
    header @assets Cache-Control "public, max-age=31536000, immutable"
    header X-Content-Type-Options nosniff
    header Referrer-Policy strict-origin-when-cross-origin

    file_server
    handle_errors {
        rewrite * /404.html
        file_server
    }
}
