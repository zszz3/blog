---
interface Project {
  name: string
  role: string
  description: string
  github: string
}

interface Props {
  projects: Project[]
}

const { projects } = Astro.props
---

<table class='project-list'>
  <caption class='sr-only'>项目名称、职责、简要介绍与 GitHub 链接</caption>
  <thead>
    <tr>
      <th scope='col'>名字</th>
      <th scope='col'>职责</th>
      <th scope='col'>简要介绍</th>
      <th scope='col'>GitHub</th>
    </tr>
  </thead>
  <tbody>
    {projects.map(project => (
      <tr>
        <th scope='row' class='project-name'>{project.name}</th>
        <td class='project-role'>{project.role}</td>
        <td class='project-description'>{project.description}</td>
        <td class='project-github'>
          <a href={project.github} target='_blank' rel='noopener noreferrer' aria-label={`${project.name} 的 GitHub 仓库`}>
            GitHub <span aria-hidden='true'>↗</span>
          </a>
        </td>
      </tr>
    ))}
  </tbody>
</table>

<style>
  .project-list {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 1rem;
    line-height: 1.75;
  }
  th, td {
    padding: 1.25rem 1.5rem 1.25rem 0;
    border-bottom: 1px solid hsl(var(--border));
    vertical-align: top;
  }
  th:last-child, td:last-child { padding-right: 0; }
  thead th {
    padding-top: 0;
    padding-bottom: .75rem;
    color: hsl(var(--muted-foreground));
    font-size: .875rem;
    font-weight: 400;
  }
  .project-name {
    width: 20%;
    font-weight: 600;
    color: hsl(var(--foreground));
    white-space: nowrap;
  }
  .project-role { width: 12%; color: hsl(var(--muted-foreground)); }
  .project-description { color: hsl(var(--muted-foreground)); }
  .project-github { width: 13%; white-space: nowrap; }
  .project-github a {
    display: inline-block;
    color: hsl(var(--primary));
    text-decoration: none;
  }
  .project-github a:hover { text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 700px) {
    thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    table, tbody { display: block; }
    tbody tr {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: .5rem 1rem;
      padding-block: 1.25rem;
      border-bottom: 1px solid hsl(var(--border));
    }
    tbody tr:first-child { padding-top: 0; }
    th, td { width: auto !important; padding: 0; border: 0; }
    .project-description, .project-github { grid-column: 1 / -1; }
    .project-github a { padding-block: .375rem; }
  }
</style>
