---
import { Icon } from 'astro-pure/user'

interface Project {
  name: string
  role: string
  description: string
  github: string
}

interface Props {
  projects: Project[]
}

const { projects } = Astro.props
---

<div class='project-grid'>
  {projects.map(project => (
    <article class='project-card'>
      <div class='project-heading'>
        <h2>{project.name}</h2>
        <span class='project-role'>{project.role}</span>
      </div>
      <p class='project-description'>{project.description}</p>
      <a class='project-link' href={project.github} target='_blank' rel='noopener noreferrer' aria-label={`${project.name} 的 GitHub 仓库`}>
        <Icon name='github-circle' class='size-5 shrink-0' />
        <span class='project-url'>{project.github}</span>
        <span class='project-arrow' aria-hidden='true'>↗</span>
      </a>
    </article>
  ))}
</div>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 28rem), 1fr));
    gap: 1.5rem;
  }
  .project-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
    padding: 1.5rem;
    border: 1px solid hsl(var(--primary) / .18);
    border-radius: 1rem;
    background: hsl(var(--background) / .8);
    box-shadow: 0 3px 12px hsl(var(--primary) / .035);
    transition: border-color .2s, box-shadow .2s;
  }
  .project-card:hover {
    border-color: hsl(var(--primary) / .38);
    box-shadow: 0 5px 20px hsl(var(--primary) / .07);
  }
  .project-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .75rem;
  }
  .project-heading h2 {
    margin: 0;
    color: hsl(var(--foreground));
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -.025em;
  }
  .project-role {
    padding: .125rem .5rem;
    border-radius: .375rem;
    background: hsl(var(--orange-surface));
    color: hsl(var(--accent-ink));
    font-size: .875rem;
    line-height: 1.5;
  }
  .project-description {
    margin: 1rem 0 .5rem;
    color: hsl(var(--muted-foreground));
    font-size: 1rem;
    line-height: 1.8;
    overflow-wrap: break-word;
  }
  .project-link {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    margin-top: auto;
    min-height: 2.75rem;
    max-width: 100%;
    color: hsl(var(--primary));
    font-size: .9375rem;
    text-decoration: none;
  }
  .project-url { min-width: 0; overflow-wrap: anywhere; }
  .project-link:hover { text-decoration: underline; text-underline-offset: 4px; }
  .project-arrow { flex-shrink: 0; margin-left: .25rem; font-size: 1.125rem; }
  @media (max-width: 480px) {
    .project-card { padding: 1.25rem; }
  }
</style>
