---
import { cn } from 'astro-pure/utils'

interface Props {
  class?: string
  title: string
  href?: string
  stacked?: boolean
}

const { class: className, title, href, stacked = false } = Astro.props
---

<section class={cn('flex flex-col gap-y-5', !stacked && 'md:flex-row md:gap-y-0', className)}>
  <div class={cn('text-xl font-medium', !stacked && 'md:min-w-36')}>
    <h2>
      {href ? (
        <a class='section-heading-link' href={href} aria-label={`查看${title}页面`}>
          {title}
        </a>
      ) : title}
    </h2>
  </div>
  <div class='flex flex-1 flex-col gap-y-3'>
    <slot />
  </div>
</section>

<style>
  .section-heading-link {
    display: inline-flex;
    align-items: center;
    color: hsl(var(--primary));
    text-decoration: underline;
    text-decoration-color: hsl(var(--primary) / .45);
    text-decoration-thickness: 1px;
    text-underline-offset: .25em;
    border-radius: .25rem;
  }
  .section-heading-link:hover,
  .section-heading-link:focus-visible {
    text-decoration-color: currentColor;
  }
</style>
