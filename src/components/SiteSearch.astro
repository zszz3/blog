---
import { Icon } from "astro-icon/components";
import { url } from "../utils/url-utils";
---
<button class="search-trigger" id="search-open" aria-label="搜索文章" aria-haspopup="dialog"><Icon name="material-symbols:search-rounded" /><span>搜索文章</span><kbd>⌘ K</kbd></button>
<dialog class="search-dialog" id="search-dialog" aria-label="搜索文章" data-index-url={url("/search.json")} data-pagefind-url={url("/pagefind/pagefind.js")}>
    <div class="search-form"><Icon name="material-symbols:search-rounded" /><input id="site-search-input" type="search" placeholder="搜索文章、标签或正文…" aria-label="搜索关键词" autocomplete="off" /><button class="icon-button" id="search-close" aria-label="关闭搜索"><Icon name="material-symbols:close-rounded" /></button></div>
    <p class="search-status" id="search-status" role="status">输入关键词，找到想读的文章。</p>
    <div class="search-results" id="search-results"></div>
</dialog>
<script>
interface SearchEntry { title: string; description: string; url: string; text: string }
interface Pagefind { search: (query: string) => Promise<{ results: { data: () => Promise<{ meta: { title?: string }; url: string; excerpt: string }> }[] }> }
const dialog = document.querySelector<HTMLDialogElement>("#search-dialog")!;
const input = document.querySelector<HTMLInputElement>("#site-search-input")!;
const status = document.querySelector<HTMLElement>("#search-status")!;
const results = document.querySelector<HTMLElement>("#search-results")!;
let fallbackIndex: Promise<SearchEntry[]> | undefined;
let pagefind: Promise<Pagefind | null> | undefined;
let generation = 0;
let debounce: ReturnType<typeof setTimeout>;
function open() { if (!dialog.open) dialog.showModal(); input.focus(); }
function close() { dialog.close(); document.getElementById("search-open")?.focus(); }
document.getElementById("search-open")?.addEventListener("click", open);
document.getElementById("search-close")?.addEventListener("click", close);
dialog.addEventListener("click", event => { if (event.target === dialog) { const rect = dialog.getBoundingClientRect(); if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) close(); } });
document.addEventListener("keydown", event => { if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") { event.preventDefault(); open(); } });
function textOnly(html: string) { return new DOMParser().parseFromString(html, "text/html").body.textContent || ""; }
async function search() {
    const current = ++generation;
    const query = input.value.trim();
    results.replaceChildren();
    if (!query) { status.textContent = "输入关键词，找到想读的文章。"; return; }
    status.textContent = "正在查找…";
    try {
        pagefind ||= import(/* @vite-ignore */ dialog.dataset.pagefindUrl!).catch(() => null);
        const engine = await pagefind;
        let matches: Pick<SearchEntry, "title" | "description" | "url">[];
        if (engine) {
            const found = await engine.search(query);
            matches = await Promise.all(found.results.slice(0, 20).map(async result => { const data = await result.data(); return { title: data.meta.title || "文章", description: textOnly(data.excerpt), url: data.url }; }));
        } else {
            fallbackIndex ||= fetch(dialog.dataset.indexUrl!).then(response => { if (!response.ok) throw new Error("index unavailable"); return response.json(); });
            const terms = query.toLocaleLowerCase().split(/\s+/);
            matches = (await fallbackIndex).filter(entry => terms.every(term => entry.text.includes(term))).slice(0, 20);
        }
        if (current !== generation) return;
        status.textContent = matches.length ? `找到 ${matches.length} 篇相关文章` : `没有找到「${query}」，试试其他关键词。`;
        for (const match of matches) {
            const link = document.createElement("a"); link.className = "search-result"; link.href = match.url;
            const title = document.createElement("strong"); title.textContent = match.title;
            const excerpt = document.createElement("p"); excerpt.textContent = match.description;
            link.append(title, excerpt); link.addEventListener("click", close); results.append(link);
        }
    } catch { if (current === generation) { fallbackIndex = undefined; status.textContent = "搜索暂时不可用，请稍后重试，或前往归档浏览。"; } }
}
input.addEventListener("input", () => { generation++; clearTimeout(debounce); debounce = setTimeout(search, 180); });
</script>
