---
import { Icon } from "astro-icon/components";
import { profileConfig } from "../../config";
import { getSortedPosts, getCategoryList, getTagList } from "../../utils/content-utils";
import { url } from "../../utils/url-utils";
import ImageWrapper from "../misc/ImageWrapper.astro";
const posts = await getSortedPosts();
const categories = await getCategoryList();
const tags = await getTagList();
---
<section class="surface profile-card">
    <a class="profile-image" aria-label="关于我借此火" href={url("/about/")}><ImageWrapper src={profileConfig.avatar || ""} alt={profileConfig.name} class="h-full" /></a>
    <h2>{profileConfig.name}</h2>
    <span class="profile-handle">@wojiecihuo</span>
    <p class="profile-bio">{profileConfig.bio}</p>
    <div class="profile-links">{profileConfig.links.map(link => <a href={link.url} target="_blank" rel="me noopener noreferrer" aria-label={link.name}><Icon name={link.icon} /></a>)}<a href={url("/rss.xml")} aria-label="RSS 订阅"><Icon name="material-symbols:rss-feed-rounded" /></a></div>
    <div class="profile-stats"><a href={url("/archive/")}><strong>{posts.length}</strong><span>文章</span></a><a href={url("/archive/")}><strong>{categories.length}</strong><span>分类</span></a><a href={url("/archive/")}><strong>{tags.length}</strong><span>标签</span></a></div>
</section>
