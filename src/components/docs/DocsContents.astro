---
import { cn } from 'astro-pure/utils'
import { articleUrl, getArticles, groupDocs } from '@/utils/articles'

type Props = { title?: boolean; class?: string; series?: string }
const { title = true, class: className, series } = Astro.props
const groups = groupDocs(await getArticles('docs')).filter(([name]) => !series || name === series)
const currentPath = decodeURI(Astro.url.pathname).replace(/\/$/, '')
---
<nav aria-label='文档系列目录' class={cn('docs-contents not-prose', className)}>
  {title && <h2 class='text-foreground font-medium'>文档目录</h2>}
  {groups.length === 0 && <p class='mt-4 text-muted-foreground'>还没有整理成系列的文档。</p>}
  <ul class='mt-4 flex flex-col gap-y-5'>
    {groups.map(([name, entries]) => (
      <li>
        <h3 class='text-muted-foreground text-sm font-medium'>{name}</h3>
        <ol class='mt-2 flex flex-col'>
          {entries.map((article, index) => (
            <li class:list={['docs-item relative ms-2 rounded-lg', { current: currentPath === articleUrl(article) }]}>
              <a class='flex items-start gap-3 px-3 py-2' href={articleUrl(article)} aria-current={currentPath === articleUrl(article) ? 'page' : undefined}>
                <span class='text-muted-foreground text-sm tabular-nums mt-0.5'>{String(index + 1).padStart(2, '0')}</span>
                <span>{article.data.title}</span>
              </a>
            </li>
          ))}
        </ol>
      </li>
    ))}
  </ul>
</nav>
<style>
  .docs-item::before { content: ''; position: absolute; inset: 0 auto 0 -.5rem; width: 2px; background: hsl(var(--border)); }
  .docs-item:hover, .docs-item.current { background: hsl(var(--blue-surface)); }
  .docs-item.current { font-weight: 500; color: hsl(var(--primary)); }
  .docs-item.current::before { background: hsl(var(--primary)); }
  .docs-item a { overflow-wrap: anywhere; }
</style>
