---
import { Icon } from "astro-icon/components";
import { navBarConfig, siteConfig } from "../config";
import { LinkPresets } from "../constants/link-presets";
import { url, pathsEqual } from "../utils/url-utils";
import LightDarkSwitch from "./LightDarkSwitch.svelte";
import Search from "./SiteSearch.astro";
import DisplaySettings from "./widget/DisplaySettings.svelte";
const links = navBarConfig.links.map((item) => typeof item === "number" ? LinkPresets[item] : item);
const icons = ["material-symbols:home-outline-rounded", "material-symbols:inventory-2-outline-rounded", "material-symbols:person-outline-rounded", "fa6-brands:github"];
---
<header class="site-header" id="navbar">
    <nav class="nav-inner" aria-label="主导航">
        <a href={url("/")} class="wordmark" aria-label="wojiecihuo 首页"><span class="brand-symbol"><Icon name="material-symbols:local-fire-department-outline-rounded" /></span>{siteConfig.title}<span class="wordmark-dot">.</span></a>
        <div class="nav-links" id="nav-links">
            {links.map((link, index) => <a data-nav-link href={link.external ? link.url : url(link.url)} target={link.external ? "_blank" : undefined} rel={link.external ? "noopener noreferrer" : undefined} aria-current={!link.external && pathsEqual(Astro.url.pathname, url(link.url)) ? "page" : undefined}>
                <Icon name={icons[index] || "material-symbols:link-rounded"} />{link.name}{link.external && <span class="external-arrow">↗</span>}
            </a>)}
        </div>
        <div class="nav-tools">
            <Search />
            <span class="nav-separator"></span>
            {!siteConfig.themeColor.fixed && <button id="display-settings-switch" class="icon-button" aria-label="主题颜色" aria-expanded="false" aria-controls="display-setting"><Icon name="material-symbols:palette-outline" /></button>}
            <LightDarkSwitch client:load />
            <button id="nav-menu-switch" class="icon-button mobile-menu-button" aria-label="展开导航" aria-controls="nav-links" aria-expanded="false"><Icon name="material-symbols:menu-rounded" /></button>
        </div>
        <DisplaySettings client:only="svelte" />
    </nav>
</header>
<script>
const menuButton = document.getElementById("nav-menu-switch");
const nav = document.getElementById("nav-links");
const settingsButton = document.getElementById("display-settings-switch");
function closePanels() {
    nav?.classList.remove("is-open");
    menuButton?.setAttribute("aria-expanded", "false");
    document.getElementById("display-setting")?.classList.add("float-panel-closed");
    settingsButton?.setAttribute("aria-expanded", "false");
}
menuButton?.addEventListener("click", () => {
    const open = nav?.classList.toggle("is-open") || false;
    menuButton.setAttribute("aria-expanded", String(open));
});
settingsButton?.addEventListener("click", () => {
    const panel = document.getElementById("display-setting");
    if (!panel) return;
    panel.classList.toggle("float-panel-closed");
    settingsButton.setAttribute("aria-expanded", String(!panel.classList.contains("float-panel-closed")));
});
document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    if (!event.target.closest("#navbar") || event.target.closest("[data-nav-link]")) closePanels();
});
document.addEventListener("keydown", (event) => { if (event.key === "Escape") closePanels(); });
</script>
