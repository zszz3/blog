---
import type { CollectionEntry } from "astro:content";
import path from "node:path";
import { Icon } from "astro-icon/components";
import { getDir, getCategoryUrl, getTagUrl } from "../utils/url-utils";
import { formatDateToYYYYMMDD } from "../utils/date-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";
interface Props { entry: CollectionEntry<"posts">; title: string; url: string; published: Date; updated?: Date; tags: string[]; category: string | null; image: string; description: string; draft: boolean; style?: string; class?: string }
const { entry, title, url, published, tags, category, image, description } = Astro.props;
const { remarkPluginFrontmatter } = await entry.render();
---
<article class="surface post-card">
    <div class="post-card-main">
        <div class="post-card-copy">
            <a class="post-category" href={getCategoryUrl(category)}><Icon name="material-symbols:folder-outline-rounded" />{category || "未分类"}</a>
            <h2><a href={url}>{title}</a></h2>
            <div class="post-meta"><span><Icon name="material-symbols:calendar-today-outline-rounded" /><time datetime={published.toISOString()}>{formatDateToYYYYMMDD(published)}</time></span><span><Icon name="material-symbols:schedule-outline-rounded" />{remarkPluginFrontmatter.minutes} 分钟</span><span>{remarkPluginFrontmatter.words.toLocaleString("zh-CN")} 字</span></div>
            <p class="post-description">{description || remarkPluginFrontmatter.excerpt}</p>
        </div>
        {image && <a class="post-thumb" href={url} aria-label={`阅读${title}`}><ImageWrapper src={image} basePath={path.join("content/posts/", getDir(entry.id))} alt={title} /></a>}
    </div>
    <div class="post-bottom"><div class="post-tags">{tags.map(tag => <a class="tag-pill" href={getTagUrl(tag)}># {tag}</a>)}</div><a class="read-more" href={url}>阅读全文<Icon name="material-symbols:arrow-forward-rounded" /></a></div>
</article>
