---
import { profileConfig } from "../config";
import { url } from "../utils/url-utils";
const icpNumber = import.meta.env.PUBLIC_ICP_NUMBER;
---
<footer class="site-footer"><div><p>© {new Date().getFullYear()} {profileConfig.name} · 代码、记录与日常</p><p class="footer-credit">Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a> · Based on <a href="https://github.com/saicaca/fuwari" target="_blank" rel="noopener noreferrer">Fuwari</a></p></div><div class="site-footer-links"><a href={url("/about/")}>关于</a><a href={url("/rss.xml")}>RSS 订阅 ↗</a><a href={url("/sitemap-index.xml")}>站点地图</a></div>{icpNumber && <a class="icp-number" href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">{icpNumber}</a>}</footer>
