---
import { Icon } from 'astro-pure/user'
import config from '@/site-config'

const { links = [], social = [] } = config.footer
---

<footer class='mx-auto mb-5 mt-16 w-full border-t pt-4'>
  <nav aria-label='页脚链接' class='flex flex-wrap items-center justify-end gap-x-4 gap-y-2 max-sm:justify-center'>
    {links.map(({ title, link, style }) => (
      <a href={link} target='_blank' rel='noopener noreferrer' class={style}>{title}</a>
    ))}
    {social.map(({ label, href, icon }) => (
      <a href={href} rel='me' aria-label={label} class='flex size-9 items-center justify-center rounded-md text-muted-foreground hover:text-primary'>
        <Icon name={icon} class='size-5' />
      </a>
    ))}
  </nav>
</footer>
