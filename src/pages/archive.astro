---
import BaseLayout from '@/layouts/BaseLayout.astro'
---
<BaseLayout meta={{title:'文章归档'}}>
  <p>文章归档已迁移。<a href='/archives'>查看全部文章</a></p>
  <script>
    const params = new URLSearchParams(location.search)
    const tag = params.get('tag'), category = params.get('category')
    const target = tag ? '/tags/' + encodeURIComponent(tag) : category ? '/search?category=' + encodeURIComponent(category) : '/archives'
    location.replace(target + location.hash)
  </script>
</BaseLayout>
