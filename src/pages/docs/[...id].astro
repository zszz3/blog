---
import { articleUrl, getArticles } from '@/utils/articles'

// Old or bookmarked document URLs resolve to the single article page.
export async function getStaticPaths() {
  return (await getArticles('docs')).map(article => ({
    params: { id: article.id }, props: { url: articleUrl(article) }
  }))
}
return Astro.redirect(encodeURI(Astro.props.url), 301)
---
