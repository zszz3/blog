---
import { Button, Collapse } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'
const headings = [{depth:2,slug:'projects',text:'项目'},{depth:2,slug:'notes',text:'学习记录'},{depth:2,slug:'more',text:'更多项目'}]
---
<PageLayout title='项目' {headings}>
  <p>这里整理做过的项目，以及项目之外的学习记录。</p>
  <h2 id='projects'>项目</h2>
  <ProjectSection projects={[{name:'我借此火 · 个人博客',description:'基于 Astro Pure 的个人站点，记录代码、学习与日常。',links:[{type:'site',href:'/'},{type:'doc',href:'/docs'}]}]} />
  <h2 id='notes'>学习记录</h2>
  <ProjectSection projects={[{name:'Java 基础',description:'Java 基础知识与常见问题整理。',links:[{type:'doc',href:'/blog/java八股/java基础'}]},{name:'MySQL 锁',description:'表级锁、行级锁与并发访问。',links:[{type:'doc',href:'/blog/mysql/mysql锁'}]}]} />
  <h2 id='more'>更多项目</h2>
  <Collapse title='后续补充'>其他项目还在整理，更新后会放在这里。</Collapse>
  <Button title='访问 GitHub' href='https://github.com/zszz3' target='_blank' variant='ahead' />
</PageLayout>
