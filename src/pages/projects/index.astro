---
import PageLayout from '@/layouts/BaseLayout.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'
---
<PageLayout meta={{ title: '项目' }}>
  <main class='w-full'>
    <div id='content-header' class='animate mb-10'>
      <h1 class='text-3xl font-medium'>项目</h1>
    </div>
    <div id='content' class='animate'>
      <ProjectSection projects={[{
        name: 'AgentRecall',
        role: 'Author',
        description: 'Agent 资产层：搜索、管理 Agent 会话、Skill、Memory。',
        github: 'https://github.com/zszz3/AgentRecall'
      }]} />
    </div>
  </main>
</PageLayout>
