---
import { Image } from 'astro:assets'
import PageLayout from '@/layouts/BaseLayout.astro'
import avatar from '@/assets/avatar.jpg'
import { integ } from '@/site-config'
---

<PageLayout meta={{ title: '关于我', description: '关于我借此火' }}>
  <main class='about-page animate'>
    <header class='about-intro'>
      <h1>About Me</h1>
      <Image src={avatar} alt='个人头像' class='about-avatar' width={176} height={176} loading='eager' />
    </header>

    <div class={integ.typography.class}>
      <ul>
        <li>🏫 <strong>Southeast University</strong></li>
        <li>🎯 <strong>Focus:</strong> RD · AI Agents · 3D Gaussian Splatting</li>
        <li>🏅 <strong>Experience:</strong> ACMer</li>
      </ul>

      <h2 id='projects'>Projects</h2>
      <p><strong>Author</strong></p>
      <ul>
        <li><a href='https://github.com/zszz3/AgentHerd' target='_blank' rel='noopener noreferrer'>AgentHerd</a> — A desktop companion that runs your coding agents for you.</li>
        <li><a href='https://github.com/zszz3/AgentRecall' target='_blank' rel='noopener noreferrer'>AgentRecall</a> — Search, manage, and migrate AI coding agent sessions.</li>
        <li><a href='https://github.com/zszz3/Pi-Jev-Guide' target='_blank' rel='noopener noreferrer'>Pi-Jev-Guide</a> — A configurable guardrail plugin for Pi Coding Agent.</li>
      </ul>
      <p><strong>Contributor</strong></p>
      <ul>
        <li><a href='https://github.com/vastsa/PI-Desktop' target='_blank' rel='noopener noreferrer'>PI-Desktop</a> — A local-first desktop app for AI coding agents.</li>
      </ul>
    </div>
  </main>
</PageLayout>

<style>
  .about-page { width: 100%; max-width: 46rem; margin: 0 auto; padding: .5rem 0 2rem; }
  .about-intro { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; margin-bottom: 1.5rem; }
  .about-intro h1 { margin: 0; color: hsl(var(--primary)); font-size: 2rem; font-weight: 600; line-height: 1.4; }
  .about-avatar { flex-shrink: 0; width: 5.5rem; height: 5.5rem; object-fit: cover; border-radius: 50%; border: 1px solid hsl(var(--primary) / .2); box-shadow: 5px 5px 0 hsl(var(--orange-surface)); }
  #projects { scroll-margin-top: 6rem; }
  @media (max-width: 480px) {
    .about-intro h1 { font-size: 1.75rem; }
    .about-avatar { width: 4.5rem; height: 4.5rem; }
  }
</style>
