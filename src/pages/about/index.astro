---
import { Image } from 'astro:assets'
import { Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'
import avatar from '@/assets/avatar.jpg'
import { theme } from '@/site-config'

// 内容参考 GitHub 主页 https://github.com/zszz3
const facts = [
  { label: '学校', value: '东南大学 · 南京' },
  { label: '方向', value: 'RD · AI Agents · 3D Gaussian Splatting' }
]

const projects = [
  {
    name: 'AgentHerd',
    role: 'Author',
    description:
      '在飞书里指挥你的 Coding Agent：主管在你的电脑上启动 Pi、Codex、Claude Code，盯着进度，做完告诉你结果。',
    github: 'https://github.com/zszz3/AgentHerd'
  },
  {
    name: 'AgentRecall',
    role: 'Author',
    description: 'Agent 资产层：搜索、管理、迁移 AI Coding Agent 的会话、Skill、Memory。',
    github: 'https://github.com/zszz3/AgentRecall'
  },
  {
    name: 'Pi-Jev-Guide',
    role: 'Author',
    description: '给 Pi Coding Agent 用的护栏插件，规则可以自己配置。',
    github: 'https://github.com/zszz3/Pi-Jev-Guide'
  },
  {
    name: 'PI-Desktop',
    role: 'Contributor',
    description: '本地优先的 AI Coding Agent 桌面端：Electron + Rust 宿主 + Pi Agent Harness，支持用户自装插件。',
    github: 'https://github.com/vastsa/PI-Desktop'
  }
]

const snake = 'https://raw.githubusercontent.com/zszz3/zszz3/output/github-contribution-grid-snake'
---

<PageLayout meta={{ title: '关于我', description: '关于我借此火' }}>
  <main class='about-page animate'>
    <header class='about-intro'>
      <div>
        <h1>关于我</h1>
        <p class='about-name'>{theme.author}</p>
        <p class='about-desc'>{theme.description}</p>
      </div>
      <Image src={avatar} alt='个人头像' class='about-avatar' width={176} height={176} loading='eager' />
    </header>

    <dl class='about-facts'>
      {
        facts.map((f) => (
          <div>
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))
      }
      <div>
        <dt>GitHub</dt>
        <dd>
          <a href='https://github.com/zszz3' target='_blank' rel='noopener noreferrer me'>
            <Icon name='github-circle' class='size-4 shrink-0' />
            zszz3
          </a>
        </dd>
      </div>
    </dl>

    <section class='about-section' aria-labelledby='projects'>
      <h2 id='projects'>项目</h2>
      <ProjectSection {projects} />
    </section>

    <section class='about-section' aria-labelledby='activity'>
      <h2 id='activity'>GitHub 动态</h2>
      <div class='about-snake'>
        <img class='snake-light' src={`${snake}.svg`} alt='GitHub 贡献图（贪吃蛇动画）' loading='lazy' />
        <img class='snake-dark' src={`${snake}-dark.svg`} alt='' loading='lazy' />
      </div>
    </section>
  </main>
</PageLayout>

<style>
  .about-page { width: 100%; max-width: 46rem; margin: 0 auto; padding: .5rem 0 2rem; }
  .about-intro { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; }
  .about-intro h1 { margin: 0; color: hsl(var(--primary)); font-size: 2rem; font-weight: 600; line-height: 1.4; }
  .about-name { margin: .75rem 0 0; font-size: 1.125rem; font-weight: 600; color: hsl(var(--foreground)); }
  .about-desc { margin: .25rem 0 0; color: hsl(var(--muted-foreground)); line-height: 1.7; }
  .about-avatar { flex-shrink: 0; width: 5.5rem; height: 5.5rem; object-fit: cover; border-radius: 50%; border: 1px solid hsl(var(--primary) / .2); box-shadow: 5px 5px 0 hsl(var(--orange-surface)); }

  .about-facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: .75rem; margin: 1.75rem 0 0; }
  .about-facts > div { padding: .75rem 1rem; border: 1px solid hsl(var(--border)); border-radius: .75rem; background: hsl(var(--muted) / .5); }
  .about-facts dt { font-size: .8rem; color: hsl(var(--muted-foreground)); }
  .about-facts dd { margin: .2rem 0 0; font-size: .9375rem; color: hsl(var(--foreground)); }
  .about-facts a { display: inline-flex; align-items: center; gap: .35rem; color: hsl(var(--primary)); text-decoration: none; }
  .about-facts a:hover { text-decoration: underline; text-underline-offset: 4px; }

  .about-section { margin-top: 3rem; scroll-margin-top: 6rem; }
  .about-section h2 { margin: 0 0 1.25rem; font-size: 1.375rem; font-weight: 600; color: hsl(var(--foreground)); }

  .about-snake { padding: 1rem; border: 1px solid hsl(var(--border)); border-radius: 1rem; }
  .about-snake img { display: block; width: 100%; height: auto; }
  .snake-dark { display: none !important; }
  :global(.dark) .snake-light { display: none !important; }
  :global(.dark) .snake-dark { display: block !important; }

  @media (max-width: 480px) {
    .about-intro h1 { font-size: 1.75rem; }
    .about-avatar { width: 4.5rem; height: 4.5rem; }
  }
</style>
