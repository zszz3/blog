---
import { Image } from 'astro:assets'
import PageLayout from '@/layouts/BaseLayout.astro'
import avatar from '@/assets/avatar.jpg'
import { integ } from '@/site-config'
---

<PageLayout meta={{ title: '关于我', description: '关于我借此火' }}>
  <main class='about-page animate'>
    <header class='about-intro'>
      <h1>关于我</h1>
      <Image src={avatar} alt='个人头像' class='about-avatar' width={176} height={176} loading='eager' />
    </header>

    <div class={integ.typography.class}>
      <ul>
        <li><strong>学校</strong>：东南大学</li>
        <li><strong>方向</strong>：RD · AI Agents · 3D Gaussian Splatting</li>
        <li><strong>经历</strong>：ACMer</li>
      </ul>

      <h2 id='projects'>正在做的开源项目</h2>
      <ul>
        <li>
          <a href='https://github.com/zszz3/AgentHerd' target='_blank' rel='noopener noreferrer'>AgentHerd</a>：在飞书里指挥
          Coding Agent。主管在你的电脑上启动 Pi、Codex 或 Claude Code，盯着进度，做完告诉你结果。
        </li>
        <li>
          <a href='https://github.com/zszz3/AgentRecall' target='_blank' rel='noopener noreferrer'>AgentRecall</a>：Agent
          资产层，搜索、管理和迁移 Coding Agent 的会话、Skill 和 Memory。
        </li>
        <li>
          <a href='https://github.com/zszz3/Pi-Jev-Guide' target='_blank' rel='noopener noreferrer'>Pi-Jev-Guide</a>：Pi
          Coding Agent 的护栏插件，规则可以自己配置。
        </li>
        <li>
          <a href='https://github.com/vastsa/PI-Desktop' target='_blank' rel='noopener noreferrer'>PI-Desktop</a>（参与贡献）：本地优先的
          Coding Agent 桌面端。
        </li>
      </ul>
    </div>
  </main>
</PageLayout>

<style>
  .about-page { width: 100%; max-width: 46rem; margin: 0 auto; padding: .5rem 0 2rem; }
  .about-intro { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; margin-bottom: 1.5rem; }
  .about-intro h1 { margin: 0; color: hsl(var(--primary)); font-size: 2rem; font-weight: 600; line-height: 1.4; }
  .about-avatar { flex-shrink: 0; width: 5.5rem; height: 5.5rem; object-fit: cover; border-radius: 50%; border: 1px solid hsl(var(--primary) / .2); box-shadow: 5px 5px 0 hsl(var(--orange-surface)); }
  #projects { scroll-margin-top: 6rem; }
  @media (max-width: 480px) {
    .about-intro h1 { font-size: 1.75rem; }
    .about-avatar { width: 4.5rem; height: 4.5rem; }
  }
</style>
