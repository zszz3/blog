---
import { Button, Timeline } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
const headings=[{depth:2,slug:'about-blog',text:'关于博客'}]
---
<PageLayout title='关于我' {headings}>
  <h2 id='about-blog'>关于博客</h2>
  <p>在这里保存技术笔记、项目记录和日常想法。</p>
  <Timeline events={[{date:'2026-09-12',content:'迁移到 Astro Theme Pure，保留原有文章，增加文档、项目和友链页面。'}]} />
  <p>使用 <a href='https://astro.build' target='_blank'>Astro</a> 与 <a href='https://github.com/cworld1/astro-theme-pure' target='_blank'>Astro Theme Pure</a>，感谢开源作者。</p>
  <Button title='订阅 RSS' href='/rss.xml' variant='ahead' />
</PageLayout>
