---
import { articleUrl, getArticles } from '@/utils/articles'
import { getUniqueTagsWithCount } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'
import ProjectCard from '@/components/home/ProjectCard.astro'
import Section from '@/components/home/Section.astro'
import ProfileSidebar from '@/components/home/ProfileSidebar.astro'
import WritingHeatmap from '@/components/home/WritingHeatmap.astro'

const allPosts = await getArticles('blog')
const posts = allPosts.slice(0, 6)
const tags = getUniqueTagsWithCount(allPosts)
const latestPost = allPosts[0]
const dateFormat = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC'
})
---
<PageLayout meta={{ title: '首页' }} highlightColor='#dbe9ff' wide>
  <main class='home-layout'>
    <aside class='profile-column animate' aria-label='个人介绍、标签与分类'>
      <ProfileSidebar posts={allPosts} />
    </aside>

    <div id='content' class='articles-column animate'>
      <section aria-label='文章列表'>
        <ul class='home-articles'>
          {posts.map(post => (
            <li>
              <article class='home-article'>
                <a href={articleUrl(post)} class='article-link'>
                  <time datetime={post.data.publishDate.toISOString()}>{dateFormat.format(post.data.publishDate)}</time>
                  <h2>{post.data.title}</h2>
                  {post.data.description && <p>{post.data.description}</p>}
                </a>
              </article>
            </li>
          ))}
        </ul>
      </section>
      <Section title='项目与归档' href='/projects' stacked>
        <div class='home-projects'>
          <ProjectCard href='/projects' heading='AgentRecall' subheading='Author · Agent 资产层' imagePath='/src/assets/projects/1.avif' />
          <ProjectCard href='/archives' heading='文章归档' subheading='按时间查阅文章' imagePath='/src/assets/projects/4.avif' />
        </div>
      </Section>
    </div>

    <aside class='discovery-column animate' aria-label='最近动态、文章热力图与站点概览'>
      <section class='home-panel recent-activity' aria-labelledby='recent-activity-title'>
        <h2 id='recent-activity-title'>最近动态</h2>
        {posts.length ? (
          <ol class='activity-list'>
            {posts.slice(0, 4).map(post => (
              <li class='activity-item'>
                <time datetime={post.data.publishDate.toISOString()}>{dateFormat.format(post.data.publishDate)}</time>
                <p>发布了文章 <a href={articleUrl(post)}>{post.data.title}</a></p>
              </li>
            ))}
          </ol>
        ) : <p class='activity-empty'>暂无动态</p>}
      </section>
      <WritingHeatmap posts={allPosts} />
      <section class='home-panel site-overview' aria-labelledby='site-overview-title'>
        <h2 id='site-overview-title'>站点概览</h2>
        <dl>
          <div><dt>文章</dt><dd>{allPosts.length}</dd></div>
          <div><dt>标签</dt><dd>{tags.length}</dd></div>
          {latestPost && <div class='latest-published'>
            <dt>最近发布</dt>
            <dd><time datetime={latestPost.data.publishDate.toISOString()}>{latestPost.data.publishDate.toISOString().slice(0, 10)}</time></dd>
          </div>}
        </dl>
      </section>
    </aside>
  </main>
</PageLayout>

<style>
  .home-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: 1.5rem;
    margin-top: -1.5rem;
    padding-bottom: 2rem;
  }
  .home-layout > * { min-width: 0; }
  .home-panel {
    border: 1px solid hsl(var(--border) / .8);
    border-radius: 1.15rem;
    background: hsl(var(--background) / .85);
    padding: 1.4rem;
    box-shadow: 0 5px 24px hsl(var(--primary) / .035);
  }
  .articles-column { display: flex; flex-direction: column; gap: 1.75rem; min-width: 0; }
  .articles-column :global(section > div:first-child) { padding: 1.1rem 1.4rem; border: 1px solid hsl(var(--border) / .8); border-radius: 1rem; background: hsl(var(--background) / .85); }
  .home-articles { display: grid; gap: .65rem; list-style: none; margin: 0; padding: 0; }
  .home-article { border: 1px solid hsl(var(--border) / .85); border-radius: .85rem; overflow: hidden; background: hsl(var(--background) / .92); transition: border-color .2s, box-shadow .2s; }
  .home-article:hover, .home-article:focus-within { border-color: hsl(var(--primary) / .45); box-shadow: 0 8px 28px hsl(var(--primary) / .07); }
  .article-link { display: flex; padding: .9rem 1.1rem; flex-direction: column; align-items: flex-start; gap: .3rem; text-decoration: none; }
  .article-link time { color: hsl(var(--muted-foreground)); font-size: .8125rem; }
  .article-link h2 { color: hsl(var(--primary)); font-size: 1.25rem; font-weight: 600; line-height: 1.4; overflow-wrap: anywhere; }
  .article-link p { color: hsl(var(--muted-foreground)); font-size: 1rem; line-height: 1.6; overflow-wrap: anywhere; }
  .article-link:hover h2, .article-link:focus-visible h2 { text-decoration: underline; text-underline-offset: .2em; }
  .home-projects { display: grid; gap: 1rem; }
  .home-projects :global(.project-card-fg) { padding: 5.5rem 1rem 1rem; }
  .home-projects :global(.project-card-fg p) { font-size: .875rem; }
  .profile-column, .discovery-column { display: grid; gap: 1.25rem; }
  .site-overview h2, .recent-activity h2 { margin: 0 0 1.25rem; font-size: 1.125rem; font-weight: 500; }
  .activity-list { list-style: none; margin: 0; padding: 0; }
  .activity-item { padding: 0 0 1.2rem .9rem; border-left: 2px solid hsl(var(--primary) / .2); }
  .activity-item:last-child { padding-bottom: 0; }
  .activity-item time { display: block; margin-bottom: .4rem; font-size: .875rem; color: hsl(var(--muted-foreground)); }
  .activity-item p, .activity-empty { font-size: .9375rem; line-height: 1.8; overflow-wrap: anywhere; }
  .activity-item a { color: hsl(var(--primary)); text-decoration: underline; text-decoration-color: hsl(var(--primary) / .4); text-underline-offset: .2em; }
  .activity-item a:hover { text-decoration-color: currentColor; }
  .site-overview dl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.2rem; margin: 0; }
  .site-overview dt { font-size: .875rem; color: hsl(var(--muted-foreground)); }
  .site-overview dd { margin: .3rem 0 0; font-size: 1.5rem; font-variant-numeric: tabular-nums; }
  .site-overview .latest-published { grid-column: 1 / -1; border-top: 1px solid hsl(var(--border)); padding-top: 1rem; }
  .latest-published dd { font-size: .9375rem; }
  @media (min-width: 560px) {
    .home-projects { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 900px) {
    .home-layout { grid-template-columns: 15rem minmax(0, 1fr); }
    .profile-column { grid-column: 1; grid-row: 1 / span 2; }
    .articles-column, .discovery-column { grid-column: 2; }
    .home-projects { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1200px) {
    .home-layout { grid-template-columns: minmax(14.5rem, 1fr) minmax(0, 2.3fr) minmax(16rem, 1.12fr); }
    .profile-column { grid-row: auto; }
    .discovery-column { grid-column: 3; }
  }
  @media (prefers-reduced-motion: reduce) {
    .home-article { transition: none; }
  }
</style>
