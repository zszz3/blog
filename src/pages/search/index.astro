---
import { getCollection } from 'astro:content'
import { Button, Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
const posts = (await getCollection('blog')).filter(post => !post.data.draft)
const tags = [...new Set(posts.flatMap(post => post.data.tags))].sort()
const categories = [...new Set(posts.map(post => post.data.category))].sort()
const years = [...new Set(posts.map(post => post.data.publishDate.getUTCFullYear()))].sort((a,b) => b-a)
---
<PageLayout meta={{ title: '搜索', description: '搜索文章、代码和文档，按分类、标签与年份筛选。' }}>
  <Button title='返回博客' href='/blog' variant='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'><h1 class='mb-6 text-3xl font-medium'>搜索</h1></div>
    <section id='content' class='animate search-page' aria-label='全文搜索'>
      <form id='search-form' role='search'>
        <label class='search-field'><Icon name='search' class='size-5' /><input id='search-input' name='q' type='search' placeholder='搜索标题、正文或代码…' aria-label='搜索关键词' autocomplete='off' /><button type='submit'>搜索</button></label>
        <div class='search-filters'>
          <label>范围<select name='kind' id='search-kind'><option value=''>全部内容</option value='blog'>博客文章</option><option value='docs'>文档</option></select></label>
          <label>分类<select name='category' id='search-category'><option value=''>全部分类</option>{categories.map(category => <option>{category}</option>)}</select></label>
          <label>标签<select name='tag' id='search-tag'><option value=''>全部标签</option>{tags.map(tag => <option>{tag}</option>)}</select></label>
          <label>年份<select name='year' id='search-year'><option value=''>全部年份</option>{years.map(year => <option>{year}</option>)}</select></label>
          <label>排序<select name='sort' id='search-sort'><option value='relevance'>相关度</option><option value='newest'>最新发布</option></select></label>
          <button id='search-reset' type='button'>重置</button>
        </div>
      </form>
      <p id='search-status' role='status' aria-live='polite'>输入关键词，或选择条件浏览文章。支持中文、英文和代码关键词。</p>
      <div id='search-suggestions'><span>试试：</span>{['Java', 'MySQL 锁', '发布'].map(term => <button type='button' data-search-term={term}>{term}</button>)}</div>
      <div id='search-results' aria-label='搜索结果'></div>
      <button id='search-more' type='button' hidden>显示更多结果</button>
      <noscript><p>启用 JavaScript 后可以搜索全文；也可以<a href='/blog'>浏览博客</a>或<a href='/docs'>查看文档</a>。</p></noscript>
    </section>
  </main>
</PageLayout>
<script>
  import '../../utils/search-client'
</script>
<style>
.search-page{max-width:900px}.search-field{display:flex;align-items:center;gap:12px;border:1px solid hsl(var(--border));border-radius:12px;padding:12px 14px;background:hsl(var(--muted)/.4)}.search-field>svg{color:hsl(var(--primary));flex:none}.search-field input{width:100%;min-width:0;font-size:17px;background:transparent;border:0;outline:none}.search-field:focus-within{border-color:hsl(var(--primary));box-shadow:0 0 0 3px hsl(var(--primary)/.12)}.search-field button{background:hsl(var(--primary));color:hsl(var(--background));padding:6px 16px;white-space:nowrap;border-radius:7px;font-size:14px}.search-filters{display:flex;flex-wrap:wrap;gap:12px;margin:20px 0}.search-filters label{display:flex;flex-direction:column;gap:5px;font-size:14px;color:hsl(var(--muted-foreground));flex:1;min-width:110px}.search-filters select{background:hsl(var(--background));border:1px solid hsl(var(--border));border-radius:7px;padding:8px;color:hsl(var(--foreground));width:100%;font:inherit}.search-filters button{font-size:14px;align-self:flex-end;padding:8px 4px;color:hsl(var(--primary))}#search-status{margin:22px 0 12px;color:hsl(var(--muted-foreground));font-size:15px}#search-suggestions[hidden]{display:none}#search-suggestions{display:flex;gap:9px;align-items:center;font-size:14px}#search-suggestions button{background:hsl(var(--muted));border-radius:6px;padding:4px 10px;color:hsl(var(--primary))}#search-more{margin:24px auto 0;border:1px solid hsl(var(--border));border-radius:8px;padding:10px 22px;color:hsl(var(--primary))}#search-more:not([hidden]){display:block}.search-page :global(.search-result){padding:24px 0;border-bottom:1px solid hsl(var(--border))}.search-page :global(.search-result h2){font-size:22px;font-weight:500;margin:5px 0 9px}.search-page :global(.result-meta){display:flex;flex-wrap:wrap;gap:9px;color:hsl(var(--muted-foreground));font-size:13px}.search-page :global(.result-kind){background:hsl(var(--warm));color:hsl(var(--warm-foreground));padding:0 7px;border-radius:4px}.search-page :global(.search-result p){font-size:15px;line-height:1.9;color:hsl(var(--muted-foreground))}.search-page :global(mark){background:hsl(var(--warm));color:hsl(var(--warm-foreground));padding:1px 2px;border-radius:3px}.search-page :global(.search-subresult){display:block;border-left:2px solid hsl(var(--border));padding:3px 0 3px 15px;margin-top:14px}.search-page :global(.search-subresult strong){font-size:15px;color:hsl(var(--primary));font-weight:500}.search-page :global(.search-subresult:hover){border-color:hsl(var(--primary))}.search-page :global(.search-subresult p){margin:4px 0 0;font-size:14px}@media(max-width:640px){.search-filters{gap:10px}.search-filters label{min-width:calc(50% - 10px);flex:1}.search-field{padding:10px}.search-field button{padding:6px 12px}.search-page :global(.search-result h2){font-size:20px}}
</style>
