---
import PageLayout from '@/layouts/BaseLayout.astro'
import { referrals } from '../../data/neitui'
---

<PageLayout meta={{ title: '内推', description: '分享经过确认的内推信息与联系人。' }}>
  <main class='referrals-page animate'>
    <header class='page-heading'>
      <p class='eyebrow'>Opportunities</p>
      <h1>内推信息</h1>
      <p class='intro'>这里收集可以公开分享的内推机会。联系前请先确认岗位是否仍在招聘。</p>
    </header>

    <section aria-labelledby='referrals-title'>
      <div class='section-heading'>
        <h2 id='referrals-title'>最新内推</h2>
        <span class='count'>{referrals.length} 条信息</span>
      </div>

      {referrals.length > 0 ? (
        <ul class='referral-list'>
          {referrals.map(referral => (
            <li>
              <article class='referral-card'>
                <div class='information'>
                  <h3>内推信息</h3>
                  <p>{referral.information}</p>
                </div>
                <dl class='contact-fields'>
                  <div>
                    <dt>内推联系人</dt>
                    <dd>{referral.contact}</dd>
                  </div>
                  <div>
                    <dt>具体联系方式</dt>
                    <dd>{referral.contactDetails}</dd>
                  </div>
                </dl>
              </article>
            </li>
          ))}
        </ul>
      ) : (
        <div class='empty-state'>
          <div class='empty-mark' aria-hidden='true'>✦</div>
          <h3>暂无内推信息</h3>
          <p>有确认可以公开的内推机会后，会更新在这里。</p>
        </div>
      )}
    </section>
  </main>
</PageLayout>

<style>
  .referrals-page { width: 100%; max-width: 58rem; margin: 0 auto; padding: .5rem 0 4rem; }
  .page-heading { padding: .5rem 0 2.5rem; border-bottom: 1px solid hsl(var(--border) / .8); }
  .eyebrow { margin: 0 0 .55rem; color: hsl(var(--primary)); font-size: .75rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; }
  h1 { margin: 0; color: hsl(var(--primary)); font-size: clamp(2rem, 5vw, 2.8rem); font-weight: 650; line-height: 1.3; }
  .intro { max-width: 38rem; margin: .9rem 0 0; color: hsl(var(--muted-foreground)); font-size: 1rem; line-height: 1.8; }
  .section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin: 2.2rem 0 1.1rem; }
  .section-heading h2 { margin: 0; font-size: 1.25rem; font-weight: 600; }
  .count { color: hsl(var(--muted-foreground)); font-size: .875rem; white-space: nowrap; }
  .referral-list { display: grid; gap: 1rem; margin: 0; padding: 0; list-style: none; }
  .referral-card { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(14rem, 1fr); gap: 1.5rem; padding: 1.5rem; border: 1px solid hsl(var(--border) / .85); border-radius: 1rem; background: hsl(var(--background) / .9); box-shadow: 0 5px 24px hsl(var(--primary) / .035); }
  .information h3, dt { margin: 0 0 .4rem; color: hsl(var(--muted-foreground)); font-size: .8rem; font-weight: 600; }
  .information p { margin: 0; color: hsl(var(--foreground)); font-size: 1.05rem; font-weight: 550; line-height: 1.7; white-space: pre-wrap; overflow-wrap: anywhere; }
  .contact-fields { display: grid; align-content: start; gap: 1.1rem; margin: 0; padding-left: 1.5rem; border-left: 1px solid hsl(var(--border)); }
  dd { margin: 0; font-size: .95rem; line-height: 1.6; white-space: pre-wrap; overflow-wrap: anywhere; }
  .empty-state { display: flex; min-height: 15rem; flex-direction: column; align-items: center; justify-content: center; padding: 2.5rem 1.5rem; border: 1px dashed hsl(var(--border)); border-radius: 1rem; background: hsl(var(--muted) / .28); text-align: center; }
  .empty-mark { display: grid; width: 2.75rem; height: 2.75rem; place-items: center; border-radius: .8rem; background: hsl(var(--blue-surface)); color: hsl(var(--primary)); font-size: 1.4rem; }
  .empty-state h3 { margin: 1rem 0 .25rem; font-size: 1.1rem; font-weight: 600; }
  .empty-state p { margin: 0; color: hsl(var(--muted-foreground)); font-size: .95rem; line-height: 1.7; }
  @media (max-width: 640px) {
    .page-heading { padding-bottom: 2rem; }
    .referral-card { grid-template-columns: minmax(0, 1fr); gap: 1.15rem; padding: 1.25rem; }
    .contact-fields { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; padding: 1rem 0 0; border-left: 0; border-top: 1px solid hsl(var(--border)); }
  }
  @media (max-width: 420px) {
    .contact-fields { grid-template-columns: minmax(0, 1fr); }
  }
</style>
