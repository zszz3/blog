---
import PageLayout from '@/layouts/StandaloneNeituiLayout.astro'
import { referrals } from '../../data/neitui'

// Once the API is live, never embed entries in static HTML: deleted contacts
// must not reappear if the API is temporarily unavailable.
const apiEnabled = import.meta.env.PUBLIC_NEITUI_API_ENABLED === 'true'
const initialReferrals = apiEnabled ? [] : referrals
const displayTime = (value: string) => new Date(value).toLocaleString('zh-CN', {
  timeZone: 'Asia/Shanghai', year: 'numeric', month: '2-digit', day: '2-digit',
  hour: '2-digit', minute: '2-digit', hour12: false
})
---

<PageLayout>
  <main class='referrals-page animate'>
    <header class='page-heading'>
      <p class='eyebrow'>Opportunities</p>
      <h1>内推信息</h1>
      <p class='intro'>这里收集可以公开分享的内推机会。联系前请先确认岗位是否仍在招聘。</p>
    </header>

    <section aria-labelledby='referrals-title'>
      <div class='section-heading'>
        <h2 id='referrals-title'>最新内推</h2>
        <div class='section-controls'>
          <span class='count' id='referral-count'>{apiEnabled ? '加载中' : `${initialReferrals.length} 条信息`}</span>
          <button class='primary-button' id='open-submit' type='button' aria-haspopup='dialog' aria-controls='submit-dialog' hidden>添加内推</button>
        </div>
      </div>

      <div class='table-scroll' id='table-scroll' hidden={initialReferrals.length === 0}>
        <table class='referral-table'>
          <thead>
            <tr>
              <th scope='col'>发布时间</th>
              <th scope='col'>内推信息</th>
              <th scope='col'>内推联系人</th>
              <th scope='col'>具体联系方式</th>
              {apiEnabled && <th scope='col'>操作</th>}
            </tr>
          </thead>
          <tbody id='referral-list'>
            {initialReferrals.map(referral => (
              <tr>
                <td><time datetime={referral.createdAt}>{displayTime(referral.createdAt)}</time></td>
                <td class='information-cell'>{referral.information}</td>
                <td>{referral.contact}</td>
                <td>{referral.contactDetails}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class='empty-state' id='empty-state' hidden={initialReferrals.length > 0}>
        <div class='empty-mark' aria-hidden='true'>✦</div>
        <h3 id='empty-title'>{apiEnabled ? '内推信息暂不可用' : '暂无内推信息'}</h3>
        <p id='empty-description'>{apiEnabled ? '请稍后再试。' : '有确认可以公开的内推机会后，会更新在这里。'}</p>
        <p class='empty-fields'>发布时间 · 内推信息 · 联系人 · 联系方式</p>
      </div>
      <p class='action-status' id='action-status' role='status'></p>
    </section>

    <p class='submission-unavailable' id='submission-unavailable'>在线投稿入口准备中。</p>
  </main>
</PageLayout>

<template id='referral-template'>
  <tr>
    <td><time data-field='createdAt'></time></td>
    <td class='information-cell' data-field='information'></td>
    <td data-field='contact'></td>
    <td data-field='contactDetails'></td>
    <td><button class='delete-button' type='button' data-delete aria-label='删除这条内推'>删除</button></td>
  </tr>
</template>

<form id='referral-form' hidden></form>
<dialog class='submission-dialog' id='submit-dialog' aria-labelledby='submit-title'>
  <h2 id='submit-title'>添加内推</h2>
  <p>填写信息后，在最后一步输入投稿密码确认发布。</p>
  <div class='submission-fields'>
    <label for='information'>内推信息</label>
    <textarea id='information' name='information' form='referral-form' rows='5' maxlength='1000' required placeholder='公司、岗位、地点及其他说明'></textarea>
    <label for='contact'>内推联系人</label>
    <input id='contact' name='contact' form='referral-form' maxlength='80' required autocomplete='name' />
    <label for='contact-details'>内推人具体联系方式</label>
    <input id='contact-details' name='contactDetails' form='referral-form' maxlength='200' required placeholder='例如：QQ、微信或邮箱' />
    <label class='consent'><input id='contact-consent' type='checkbox' form='referral-form' required /> 我确认联系人同意在此页面公开上述联系方式</label>
    <div class='dialog-actions'>
      <button type='button' data-close='submit-dialog'>取消</button>
      <button class='primary-button' type='submit' form='referral-form'>下一步</button>
    </div>
  </div>
</dialog>

<dialog class='password-dialog' id='add-dialog' aria-labelledby='add-dialog-title'>
  <form id='add-password-form'>
    <h2 id='add-dialog-title'>确认发布</h2>
    <p>请输入投稿密码，确认新增这条内推。</p>
    <label for='add-password'>投稿密码</label>
    <input id='add-password' type='password' required autocomplete='off' />
    <p class='dialog-error' id='add-error' role='alert'></p>
    <div class='dialog-actions'>
      <button type='button' data-close='add-dialog'>取消</button>
      <button class='primary-button' type='submit'>确认发布</button>
    </div>
  </form>
</dialog>

<dialog class='password-dialog' id='delete-dialog' aria-labelledby='delete-dialog-title'>
  <form id='delete-password-form'>
    <h2 id='delete-dialog-title'>删除内推</h2>
    <p>请输入单独的删除密码。删除后这条信息将不再公开展示。</p>
    <label for='delete-password'>删除密码</label>
    <input id='delete-password' type='password' required autocomplete='off' />
    <p class='dialog-error' id='delete-error' role='alert'></p>
    <div class='dialog-actions'>
      <button type='button' data-close='delete-dialog'>取消</button>
      <button class='primary-button' type='submit'>确认删除</button>
    </div>
  </form>
</dialog>

<script>
  interface ReferralRecord {
    id: string
    information: string
    contact: string
    contactDetails: string
    createdAt: string
  }

  const list = document.querySelector<HTMLTableSectionElement>('#referral-list')!
  const tableScroll = document.querySelector<HTMLElement>('#table-scroll')!
  const count = document.querySelector<HTMLElement>('#referral-count')!
  const empty = document.querySelector<HTMLElement>('#empty-state')!
  const emptyTitle = document.querySelector<HTMLElement>('#empty-title')!
  const emptyDescription = document.querySelector<HTMLElement>('#empty-description')!
  const template = document.querySelector<HTMLTemplateElement>('#referral-template')!
  const openSubmit = document.querySelector<HTMLButtonElement>('#open-submit')!
  const unavailable = document.querySelector<HTMLElement>('#submission-unavailable')!
  const actionStatus = document.querySelector<HTMLElement>('#action-status')!
  const form = document.querySelector<HTMLFormElement>('#referral-form')!
  const submitDialog = document.querySelector<HTMLDialogElement>('#submit-dialog')!
  const addDialog = document.querySelector<HTMLDialogElement>('#add-dialog')!
  const deleteDialog = document.querySelector<HTMLDialogElement>('#delete-dialog')!
  let deleteId = ''

  const errorMessage = (error: string) => ({
    wrong_password: '密码不正确，请重试。',
    too_many_attempts: '尝试次数过多，请稍后再试。',
    invalid_referral: '请检查填写的信息和联系人公开授权。',
    not_found: '这条内推已不存在，请刷新页面。'
  })[error] || '操作失败，请稍后再试。'

  async function send(path: string, data: Record<string, unknown>) {
    const response = await fetch(path, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data), credentials: 'omit', cache: 'no-store'
    })
    const result = await response.json().catch(() => ({ error: 'server_error' }))
    if (!response.ok) throw new Error(errorMessage(result.error))
    return result
  }

  function render(items: ReferralRecord[]) {
    const fragment = document.createDocumentFragment()
    for (const item of items) {
      const row = template.content.cloneNode(true) as DocumentFragment
      for (const field of ['information', 'contact', 'contactDetails'] as const) {
        row.querySelector<HTMLElement>(`[data-field='${field}']`)!.textContent = item[field]
      }
      const time = row.querySelector<HTMLTimeElement>('[data-field=createdAt]')!
      const timestamp = new Date(item.createdAt)
      if (!Number.isNaN(timestamp.getTime())) {
        time.dateTime = item.createdAt
        time.textContent = timestamp.toLocaleString('zh-CN', {
          timeZone: 'Asia/Shanghai', year: 'numeric', month: '2-digit', day: '2-digit',
          hour: '2-digit', minute: '2-digit', hour12: false
        })
      } else {
        time.textContent = '—'
      }
      row.querySelector<HTMLButtonElement>('[data-delete]')!.addEventListener('click', () => {
        deleteId = item.id
        document.querySelector<HTMLInputElement>('#delete-password')!.value = ''
        document.querySelector<HTMLElement>('#delete-error')!.textContent = ''
        deleteDialog.showModal()
      })
      fragment.append(row)
    }
    list.replaceChildren(fragment)
    tableScroll.hidden = items.length === 0
    empty.hidden = items.length > 0
    emptyTitle.textContent = '暂无内推信息'
    emptyDescription.textContent = '有确认可以公开的内推机会后，会更新在这里。'
    count.textContent = `${items.length} 条信息`
  }

  async function refresh() {
    const response = await fetch('/api/neitui', { cache: 'no-store' })
    if (!response.ok) throw new Error('API unavailable')
    const data = await response.json()
    if (!Array.isArray(data.referrals)) throw new Error('Invalid response')
    render(data.referrals)
    openSubmit.hidden = false
    unavailable.hidden = true
  }

  refresh().catch(() => { unavailable.textContent = '在线投稿暂不可用，请稍后再试。' })

  openSubmit.addEventListener('click', () => {
    form.reset()
    submitDialog.showModal()
    document.querySelector<HTMLTextAreaElement>('#information')!.focus()
  })

  submitDialog.addEventListener('cancel', () => form.reset())

  form.addEventListener('submit', event => {
    event.preventDefault()
    if (!form.reportValidity()) return
    actionStatus.textContent = ''
    document.querySelector<HTMLInputElement>('#add-password')!.value = ''
    document.querySelector<HTMLElement>('#add-error')!.textContent = ''
    addDialog.showModal()
  })

  document.querySelector<HTMLFormElement>('#add-password-form')!.addEventListener('submit', async event => {
    event.preventDefault()
    const button = addDialog.querySelector<HTMLButtonElement>('button[type=submit]')!
    button.disabled = true
    try {
      await send('/api/neitui', {
        information: document.querySelector<HTMLTextAreaElement>('#information')!.value,
        contact: document.querySelector<HTMLInputElement>('#contact')!.value,
        contactDetails: document.querySelector<HTMLInputElement>('#contact-details')!.value,
        contactConsent: (document.querySelector<HTMLInputElement>('#contact-consent')!).checked,
        password: document.querySelector<HTMLInputElement>('#add-password')!.value
      })
      addDialog.close()
      submitDialog.close()
      form.reset()
      actionStatus.textContent = '发布成功，内推信息已加入列表。'
      await refresh().catch(() => { actionStatus.textContent = '发布成功，请刷新页面查看。' })
    } catch (error) {
      document.querySelector<HTMLElement>('#add-error')!.textContent = error instanceof Error && !error.message.includes('fetch') ? error.message : '发布失败，请稍后再试。'
    } finally {
      button.disabled = false
    }
  })

  document.querySelector<HTMLFormElement>('#delete-password-form')!.addEventListener('submit', async event => {
    event.preventDefault()
    const button = deleteDialog.querySelector<HTMLButtonElement>('button[type=submit]')!
    button.disabled = true
    try {
      await send('/api/neitui/delete', {
        id: deleteId,
        password: document.querySelector<HTMLInputElement>('#delete-password')!.value
      })
      deleteDialog.close()
      actionStatus.textContent = '删除成功，这条内推已从列表撤下。'
      await refresh().catch(() => { actionStatus.textContent = '删除成功，请刷新页面查看。' })
    } catch (error) {
      document.querySelector<HTMLElement>('#delete-error')!.textContent = error instanceof Error && !error.message.includes('fetch') ? error.message : '删除失败，请稍后再试。'
    } finally {
      button.disabled = false
    }
  })

  document.querySelectorAll<HTMLButtonElement>('[data-close]').forEach(button => {
    button.addEventListener('click', () => {
      const dialog = document.querySelector<HTMLDialogElement>(`#${button.dataset.close}`)
      dialog?.close()
      if (dialog === submitDialog) form.reset()
    })
  })
</script>

<style>
  [hidden] { display: none !important; }
  .referrals-page { width: 100%; max-width: 60rem; margin: 0 auto; padding: clamp(2rem, 6vw, 4.5rem) 1rem 4rem; }
  .page-heading { padding: .5rem 0 2.5rem; border-bottom: 1px solid hsl(var(--border) / .8); }
  .eyebrow { margin: 0 0 .55rem; color: hsl(var(--primary)); font-size: .75rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; }
  h1 { margin: 0; color: hsl(var(--primary)); font-size: clamp(2rem, 5vw, 2.8rem); font-weight: 650; line-height: 1.3; }
  .intro { max-width: 38rem; margin: .9rem 0 0; color: hsl(var(--muted-foreground)); font-size: 1rem; line-height: 1.8; }
  .section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin: 2.2rem 0 1.1rem; }
  .section-heading h2 { margin: 0; font-size: 1.25rem; font-weight: 600; }
  .section-controls { display: flex; align-items: center; gap: 1rem; }
  .count { color: hsl(var(--muted-foreground)); font-size: .875rem; white-space: nowrap; }
  .table-scroll { overflow-x: auto; border: 1px solid hsl(var(--border)); border-radius: .8rem; background: hsl(var(--background) / .9); }
  .referral-table { width: 100%; min-width: 51rem; border-collapse: collapse; table-layout: fixed; text-align: left; }
  .referral-table th, .referral-table td { padding: .9rem .8rem; vertical-align: top; overflow-wrap: anywhere; }
  .referral-table th { background: hsl(var(--muted) / .55); color: hsl(var(--muted-foreground)); font-size: .8rem; font-weight: 650; white-space: nowrap; }
  .referral-table th:first-child { width: 8.5rem; }
  .referral-table th:nth-child(3) { width: 7.5rem; }
  .referral-table th:nth-child(4) { width: 10.5rem; }
  .referral-table th:last-child:nth-child(5) { width: 4.5rem; }
  .referral-table tbody tr + tr { border-top: 1px solid hsl(var(--border) / .7); }
  .referral-table td { font-size: .9rem; line-height: 1.65; white-space: pre-wrap; }
  .referral-table time { color: hsl(var(--muted-foreground)); font-size: .82rem; white-space: nowrap; }
  .information-cell { color: hsl(var(--foreground)); font-weight: 550; }
  .empty-state { display: flex; min-height: 15rem; flex-direction: column; align-items: center; justify-content: center; padding: 2.5rem 1.5rem; border: 1px dashed hsl(var(--border)); border-radius: 1rem; background: hsl(var(--muted) / .28); text-align: center; }
  .empty-mark { display: grid; width: 2.75rem; height: 2.75rem; place-items: center; border-radius: .8rem; background: hsl(var(--blue-surface)); color: hsl(var(--primary)); font-size: 1.4rem; }
  .empty-state h3 { margin: 1rem 0 .25rem; font-size: 1.1rem; font-weight: 600; }
  .empty-state p { margin: 0; color: hsl(var(--muted-foreground)); font-size: .95rem; line-height: 1.7; }
  .empty-state .empty-fields { margin-top: 1rem; color: hsl(var(--primary) / .8); font-size: .8rem; }
  .action-status { min-height: 1.5em; margin: 1rem 0 0; color: hsl(var(--primary)); font-size: .9rem; }
  .submission-unavailable { color: hsl(var(--muted-foreground)); font-size: .9rem; line-height: 1.7; }
  .submission-fields { display: grid; gap: .6rem; margin-top: 1.2rem; }
  .submission-fields > label:not(.consent), .password-dialog label { font-size: .9rem; font-weight: 600; }
  .submission-fields input:not([type=checkbox]), .submission-fields textarea, .password-dialog input { width: 100%; padding: .75rem .85rem; border: 1px solid hsl(var(--border)); border-radius: .55rem; background: hsl(var(--background)); color: hsl(var(--foreground)); font: inherit; }
  .submission-fields textarea { resize: vertical; }
  .submission-fields input:focus-visible, .submission-fields textarea:focus-visible, .password-dialog input:focus-visible { outline: 2px solid hsl(var(--primary)); outline-offset: 2px; }
  .consent { display: flex; align-items: flex-start; gap: .55rem; margin: .6rem 0; color: hsl(var(--muted-foreground)); font-size: .85rem; line-height: 1.6; }
  .consent input { margin-top: .25rem; }
  .primary-button { justify-self: start; padding: .65rem 1.15rem; border: 0; border-radius: .55rem; background: hsl(var(--primary)); color: hsl(var(--background)); font-size: .9rem; font-weight: 600; cursor: pointer; }
  .primary-button:disabled { opacity: .55; cursor: wait; }
  .delete-button { padding: 0; border: 0; background: transparent; color: hsl(var(--muted-foreground)); font-size: .8rem; cursor: pointer; }
  .delete-button:hover { color: hsl(var(--primary)); text-decoration: underline; }
  .delete-button:focus-visible { outline: 2px solid hsl(var(--primary)); outline-offset: 3px; }
  .submission-dialog, .password-dialog { padding: 1.5rem; border: 1px solid hsl(var(--border)); border-radius: 1rem; background: hsl(var(--background)); color: hsl(var(--foreground)); box-shadow: 0 18px 60px hsl(var(--foreground) / .18); }
  .submission-dialog { width: min(38rem, calc(100vw - 2rem)); max-height: min(90dvh, 46rem); overflow-y: auto; }
  .password-dialog { width: min(25rem, calc(100vw - 2rem)); }
  .submission-dialog::backdrop, .password-dialog::backdrop { background: hsl(0 0% 0% / .4); }
  .submission-dialog h2, .password-dialog h2 { margin: 0; font-size: 1.2rem; }
  .submission-dialog p, .password-dialog p { color: hsl(var(--muted-foreground)); font-size: .9rem; line-height: 1.6; }
  .password-dialog label { display: block; margin: 1.2rem 0 .5rem; }
  .password-dialog .dialog-error { min-height: 1.4em; margin: .5rem 0; color: #c63b3b; }
  .dialog-actions { display: flex; justify-content: flex-end; align-items: center; gap: .8rem; }
  .dialog-actions button:not(.primary-button) { padding: .6rem; border: 0; background: transparent; color: hsl(var(--muted-foreground)); cursor: pointer; }
  @media (max-width: 640px) {
    .page-heading { padding-bottom: 2rem; }
    .referral-table { min-width: 48rem; }
    .section-heading { align-items: flex-start; }
    .section-controls { flex-wrap: wrap; justify-content: flex-end; gap: .5rem; }
  }
</style>
