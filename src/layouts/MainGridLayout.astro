---
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
import Navbar from "@components/Navbar.astro";
import Footer from "@components/Footer.astro";
import ImageWrapper from "@components/misc/ImageWrapper.astro";
import SideBar from "@components/widget/SideBar.astro";
import RightSidebar from "@components/widget/RightSidebar.astro";
import { profileConfig, siteConfig } from "../config";
import { pathsEqual, url } from "../utils/url-utils";
import Layout from "./Layout.astro";

interface Props {
    title?: string;
    banner?: string;
    description?: string;
    lang?: string;
    setOGTypeArticle?: boolean;
    headings?: MarkdownHeading[];
}
const { title, banner, description, lang, setOGTypeArticle, headings = [] } = Astro.props;
const isHome = pathsEqual(Astro.url.pathname, url("/"));
---
<Layout title={title} banner={banner} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle}>
    <slot slot="head" name="head" />
    <Navbar />
    <div id="site-content" class="transition-swup-fade">
        {siteConfig.banner.enable && <header class:list={["site-hero", { "hero-home": isHome }]}>
            <ImageWrapper src={siteConfig.banner.src} alt="初音未来插画横幅" position={siteConfig.banner.position} class="hero-image" eager />
            <div class="hero-shade"></div>
            <div class="hero-copy">
                <span class="hero-eyebrow">CODE & NOTES</span>
                {isHome ? <h1>我借此火<span class="hero-dot">.</span></h1> : <p class="hero-name">我借此火<span class="hero-dot">.</span></p>}
                <p class="hero-motto">{profileConfig.bio}</p>
                <span class="hero-rule"></span>
                <span class="hero-caption">记录所学，也收藏生活。</span>
            </div>
            {isHome && <a class="hero-scroll" href="#main-content" aria-label="开始阅读"><Icon name="material-symbols:keyboard-arrow-down-rounded" /></a>}
        </header>}
        <div class:list={["site-grid", { "without-hero": !siteConfig.banner.enable, "reading-layout": setOGTypeArticle }]}>
            <SideBar />
            <main id="main-content" tabindex="-1">
                <div id="content-wrapper"><slot /></div>
            </main>
            <RightSidebar headings={headings} />
        </div>
        <Footer />
    </div>
    <a class="back-to-top icon-button" href="#" aria-label="回到顶部"><Icon name="material-symbols:arrow-upward-rounded" /></a>
</Layout>
