---
import "@fontsource/roboto/400.css";
import "@fontsource/roboto/500.css";
import "@fontsource/roboto/700.css";
import "katex/dist/katex.css";
import "../styles/variables.styl";
import "../styles/main.css";
import "../styles/markdown-extend.styl";
import "../styles/expressive-code.css";
import "../styles/redesign.css";
import ConfigCarrier from "@components/ConfigCarrier.astro";
import { profileConfig, siteConfig } from "@/config";
import { DEFAULT_THEME } from "../constants/constants";
import { defaultFavicons } from "../constants/icon";
import { url } from "../utils/url-utils";

interface Props {
    title?: string;
    banner?: string;
    description?: string;
    lang?: string;
    setOGTypeArticle?: boolean;
}
const { title, description, lang, setOGTypeArticle } = Astro.props;
const pageTitle = title ? `${title} - ${siteConfig.title}` : `${siteConfig.title} · ${siteConfig.subtitle}`;
const pageDescription = description || `${profileConfig.name}的个人博客，记录 Java、数据库与技术学习，也收藏生活。`;
const favicons = siteConfig.favicon.length ? siteConfig.favicon : defaultFavicons;
const canonical = new URL(Astro.url.pathname.endsWith("/404/") ? url("/404.html") : Astro.url.pathname, Astro.site);
---
<!DOCTYPE html>
<html lang={(lang || siteConfig.lang).replace("_", "-")}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{pageTitle}</title>
        <meta name="description" content={pageDescription} />
        <meta name="author" content={profileConfig.name} />
        <meta name="generator" content={Astro.generator} />
        <link rel="canonical" href={canonical} />
        <meta property="og:site_name" content={siteConfig.title} />
        <meta property="og:url" content={canonical} />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={pageDescription} />
        <meta property="og:type" content={setOGTypeArticle ? "article" : "website"} />
        <meta name="twitter:card" content="summary" />
        {favicons.map((favicon) => <link rel="icon" href={favicon.src.startsWith("/") ? url(favicon.src) : favicon.src} sizes={favicon.sizes} media={favicon.theme && `(prefers-color-scheme: ${favicon.theme})`} />)}
        <link rel="alternate" type="application/rss+xml" title={profileConfig.name} href={new URL(url("rss.xml"), Astro.site)} />
        <script is:inline define:vars={{ defaultTheme: DEFAULT_THEME, configHue: siteConfig.themeColor.hue }}>
            let theme = defaultTheme;
            let hue = configHue;
            try { theme = localStorage.getItem('theme') || theme; hue = Number(localStorage.getItem('hue')) || hue; } catch {}
            document.documentElement.classList.toggle('dark', theme === 'dark' || (theme === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches));
            document.documentElement.style.setProperty('--hue', String(hue));
        </script>
        <slot name="head" />
    </head>
    <body>
        <a class="skip-link" href="#main-content">跳转到正文</a>
        <ConfigCarrier />
        <slot />
    </body>
</html>
<script>
import PhotoSwipeLightbox from "photoswipe/lightbox";
import "photoswipe/style.css";
let lightbox: PhotoSwipeLightbox | undefined;
function initializePage() {
    lightbox?.destroy();
    lightbox = new PhotoSwipeLightbox({
        gallery: ".custom-md img, #post-cover img",
        pswpModule: () => import("photoswipe"),
        wheelToZoom: true,
        imageClickAction: "close",
        tapAction: "close",
        doubleTapAction: "zoom",
    });
    lightbox.addFilter("domItemData", (item, element) => {
        if (element instanceof HTMLImageElement) {
            item.src = element.currentSrc || element.src;
            item.w = element.naturalWidth;
            item.h = element.naturalHeight;
            item.msrc = element.src;
        }
        return item;
    });
    lightbox.init();
    document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]").forEach((link) => {
        const active = new URL(link.href).pathname.replace(/\/$/, "") === location.pathname.replace(/\/$/, "");
        if (active) link.setAttribute("aria-current", "page");
        else link.removeAttribute("aria-current");
    });
}
initializePage();
function setup() { window.swup.hooks.on("page:view", initializePage); }
if (window.swup) setup();
else document.addEventListener("swup:enable", setup, { once: true });
window.addEventListener("scroll", () => {
    document.body.classList.toggle("has-scrolled", window.scrollY > 100);
}, { passive: true });
</script>
