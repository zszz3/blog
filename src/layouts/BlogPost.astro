---
import type { MarkdownHeading } from 'astro'
import type { CollectionEntry } from 'astro:content'

// Plugin styles
import 'katex/dist/katex.min.css'

import { MediumZoom } from 'astro-pure/advanced'
import { ArticleBottom, Hero, TOC } from 'astro-pure/components/pages'
import config from 'virtual:config'
import SearchMetadata from '@/components/SearchMetadata.astro'
import Copyright from '@/components/ArticleCopyright.astro'
import PageLayout from '@/layouts/ContentLayout.astro'
import { Comment, PageInfo } from '@/components/waline'
import DocsContents from '@/components/docs/DocsContents.astro'
import { groupDocs } from '@/utils/articles'

interface Props {
  post: CollectionEntry<'blog'>
  posts: CollectionEntry<'blog'>[]
  headings: MarkdownHeading[]
  remarkPluginFrontmatter: Record<string, unknown>
}

const {
  post: { id, data },
  posts,
  headings,
  remarkPluginFrontmatter
} = Astro.props

const {
  description,
  heroImage,
  publishDate,
  title,
  updatedDate,
  draft: isDraft,
  comment: enableComment
} = data

const socialImage = heroImage
  ? typeof heroImage.src === 'string'
    ? heroImage.src
    : heroImage.src.src
  : config.socialCard
const articleDate = updatedDate?.toISOString() ?? publishDate.toISOString()
const primaryColor = data.heroImage?.color ?? 'hsl(var(--primary) / var(--un-text-opacity))'
const isDocument = data.views.includes('docs')
const seriesName = data.series || '其他文档'
const seriesPosts = isDocument ? groupDocs(posts).find(([name]) => name === seriesName)?.[1] || [] : []
const adjacentPosts = isDocument ? seriesPosts : posts.filter(post => post.data.views.includes('blog'))
---

<PageLayout
  meta={{ articleDate, description, ogImage: socialImage, title }}
  highlightColor={primaryColor}
>
  <Fragment slot='sidebar'>
    {isDocument && <DocsContents title={false} series={seriesName} class='mb-6' />}
    {!!headings.length && <TOC {headings} />}
  </Fragment>

  <div slot='header' data-pagefind-body data-pagefind-weight='5'>
  <Hero {data} {remarkPluginFrontmatter}>
    <Fragment slot='description'>
      {!isDraft && enableComment && <PageInfo comment class='mt-1' />}
    </Fragment>
  </Hero>
  </div>

  <SearchMetadata views={data.views} title={title} date={publishDate} category={data.category} tags={data.tags} />
  <div data-pagefind-body><slot /></div>

  <Fragment slot='bottom'>
    {/* Copyright */}
    <Copyright {data} />
    {/* Article recommend */}
    {isDocument && <p class='mt-4 text-sm'><a href='/docs'>{seriesName}</a> · 第 {seriesPosts.findIndex(post => post.id === id) + 1} / {seriesPosts.length} 篇</p>}
    <ArticleBottom collections={adjacentPosts} {id} class='mt-3 sm:mt-6' />
    { /* Comment */
    !isDraft && enableComment && <Comment class='mt-3 sm:mt-6' />}
  </Fragment>

  <slot name='bottom-sidebar' slot='bottom-sidebar' />
</PageLayout>

{config.integ.mediumZoom.enable && <MediumZoom />}
